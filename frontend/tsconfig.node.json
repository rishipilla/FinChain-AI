{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["vite.config.ts", "vite.config.js", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}